# --- Tox профиль ---
# Путь к профилю внутри контейнера. Положи свой .tox-файл в ./data/ и укажи
# здесь его имя (например /data/profile.tox).
TOX_PROFILE_PATH=/data/profile.tox
# Пароль шифрования профиля qTox (профиль зашифрован - обязателен).
TOX_PROFILE_PASSWORD=

# --- Telegram ---
# Токен бота от @BotFather. ВАЖНО: включи у бота Threaded Mode в @BotFather,
# иначе создание топиков в личке вернёт BOT_FORUM_CREATE_FORBIDDEN.
TELEGRAM_BOT_TOKEN=
# Твой Telegram user id. Можно оставить пустым и отправить боту /start -
# id определится автоматически и сохранится.
TELEGRAM_OWNER_ID=

# Режим топиков: private (топики в личном чате с ботом, по умолчанию)
# или supergroup (fallback на forum-супергруппу, если private сломается).
TELEGRAM_TOPIC_MODE=private
# Нужен только при TELEGRAM_TOPIC_MODE=supergroup.
TELEGRAM_CHAT_ID=

# --- Прочее ---
DB_PATH=/data/bridge.db
TMP_DIR=/data/tmp
# Лимит размера файла (Telegram отдаёт боту максимум 20 МБ).
MAX_FILE_MB=50
LOG_LEVEL=INFO
